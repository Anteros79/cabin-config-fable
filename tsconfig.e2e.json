{
  // The browser-driving E2E runner. It is Node code whose page.evaluate callbacks
  // run in the page, so it needs Node types and the DOM library, and it sees
  // src/web for the window.__cabinKit test hook type.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "jsx": "react-jsx",
    "tsBuildInfoFile": "./node_modules/.cache/tsc/e2e.tsbuildinfo"
  },
  "include": ["tests/e2e", "src/web"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
